---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, waLink } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = SITE.nombre,
  description = 'Agencia de autos usados y 0km en San Martín, Mendoza. Compra, venta, permuta, financiación y consignación de vehículos seleccionados. Consultá por WhatsApp.',
  image = '/brand/og.svg',
} = Astro.props;
const fullTitle = title === SITE.nombre ? title : `${title} · ${SITE.nombre}`;
const canonical = new URL(Astro.url.pathname, SITE.dominio).href;

// Coordenadas aproximadas de Boulogne Sur Mer 160, San Martín, Mendoza.
const GEO = { lat: -33.0817, lng: -68.4681 };

// Redes sociales para el campo "sameAs" del esquema.
const sameAs = [SITE.instagram, SITE.facebook].filter(Boolean);

// Datos estructurados schema.org (AutoDealer) — le dice a Google qué es,
// dónde está, teléfono, horarios y redes. Clave para el SEO local.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': SITE.dominio + '/#agencia',
  name: 'Prisco Automotores',
  description:
    'Agencia de autos usados y 0km en San Martín, Mendoza. Compra, venta, permuta, financiación y consignación de vehículos seleccionados.',
  url: SITE.dominio,
  logo: SITE.dominio + '/brand/logo-original.png',
  image: SITE.dominio + '/brand/logo-original.png',
  telephone: '+' + SITE.whatsapp,
  priceRange: '$$',
  currenciesAccepted: 'ARS',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Boulogne Sur Mer 160',
    addressLocality: 'San Martín',
    addressRegion: 'Mendoza',
    postalCode: 'M5570',
    addressCountry: 'AR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: GEO.lat, longitude: GEO.lng },
  areaServed: [
    { '@type': 'City', name: 'San Martín' },
    { '@type': 'AdministrativeArea', name: 'Mendoza' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
  sameAs,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, SITE.dominio).href} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, SITE.dominio).href} />
    <!-- Geolocalización para búsquedas locales -->
    <meta name="geo.region" content="AR-M" />
    <meta name="geo.placename" content="San Martín, Mendoza" />
    <meta name="geo.position" content={`${GEO.lat};${GEO.lng}`} />
    <meta name="ICBM" content={`${GEO.lat}, ${GEO.lng}`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <!-- Datos estructurados de la agencia (schema.org AutoDealer) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#0B0C0F" />
    <link rel="icon" href="/brand/logo-original.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Saira+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a
      class="wa-float"
      href={waLink('Hola, quiero hacer una consulta.')}
      aria-label="Escribir por WhatsApp"
      target="_blank"
      rel="noopener"
    >
      <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.6c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.8.9.8 1.7 1 2 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
    </a>
  </body>
</html>
