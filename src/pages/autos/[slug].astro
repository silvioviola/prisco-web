---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { autoTitulo, autoFotos } from '../../lib/autos';
import { SITE, waLink, precioFmt, kmFmt } from '../../lib/site';

export async function getStaticPaths() {
  const autos = await getCollection('autos');
  return autos.map((auto) => ({ params: { slug: auto.slug }, props: { auto } }));
}

const { auto } = Astro.props;
const d = auto.data;
const titulo = autoTitulo(d);
const fotos = autoFotos(d);
const { Content } = await auto.render();
const msg = `Hola, me interesa la ${titulo} (${d.anio}) publicada en la web por ${precioFmt(d.precio, d.moneda)}. ¿Sigue disponible?`;

const I = {
  cal: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>',
  gauge: '<svg viewBox="0 0 24 24"><path d="M4 18a8 8 0 1 1 16 0"/><path d="M12 18l4-5"/></svg>',
  gear: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2"/></svg>',
  fuel: '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="9" height="16" rx="1"/><path d="M13 9h3l2 2v6a2 2 0 0 1-4 0v-3h-1"/></svg>',
  car: '<svg viewBox="0 0 24 24"><path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5v5H3z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="16.5" cy="18" r="1.5"/></svg>',
  drop: '<svg viewBox="0 0 24 24"><path d="M12 3s6 6 6 10a6 6 0 0 1-12 0c0-4 6-10 6-10z"/></svg>',
};
const specs = [
  { i: I.cal, v: String(d.anio), k: 'Año' },
  { i: I.gauge, v: kmFmt(d.km), k: 'Kilómetros' },
  { i: I.gear, v: d.transmision, k: 'Transmisión' },
  { i: I.fuel, v: d.combustible, k: 'Combustible' },
  { i: I.car, v: d.segmento, k: 'Tipo' },
  { i: I.drop, v: d.color || '—', k: 'Color' },
];
---
<Base title={titulo} description={`${titulo} ${d.anio} — ${precioFmt(d.precio, d.moneda)}. ${kmFmt(d.km)}. En PRISCO Automotores, San Martín, Mendoza.`} image={fotos[0]}>
  <section class="section">
    <div class="container">
      <p style="margin-bottom:20px"><a href="/stock" style="color:var(--muted);font-family:var(--f-mono);font-size:.86rem">← Volver al stock</a></p>
      <div class="ficha">
        <div class="gallery">
          <div class="main"><img id="mainImg" src={fotos[0]} alt={titulo} width="900" height="560" /></div>
          {fotos.length > 1 && (
            <div class="thumbs">
              {fotos.map((f, i) => (
                <img src={f} alt={`${titulo} ${i + 1}`} class={i === 0 ? 'active' : ''} data-src={f} loading="lazy" />
              ))}
            </div>
          )}
          {auto.body && auto.body.trim() && (
            <div class="desc" style="margin-top:28px">
              <h2>Descripción</h2>
              <Content />
            </div>
          )}
        </div>

        <aside class="ficha-panel">
          <p class="seg">{d.segmento}</p>
          <h1>{titulo}</h1>
          <div class="ficha-price">{precioFmt(d.precio, d.moneda)}</div>
          {d.cuotaDesde && <div class="ficha-cuota">Cuotas desde ${d.cuotaDesde.toLocaleString('es-AR')}</div>}
          <div class="ficha-badges">
            {d.estado === 'Reservado' && <span class="badge badge-reservado">Reservado</span>}
            {d.estado === 'Vendido' && <span class="badge badge-vendido">Vendido</span>}
            {d.permuta && <span class="badge">Acepta permuta</span>}
            {d.financiacion && <span class="badge">Financiación</span>}
            {d.consignacion && <span class="badge">Consignación</span>}
          </div>
          <ul class="specs">
            {specs.map((s) => (
              <li><div class="ic" set:html={s.i}></div><div class="v">{s.v}</div><div class="k">{s.k}</div></li>
            ))}
          </ul>
          <a class="btn btn-wa btn-block" href={waLink(msg)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.6c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.8.9.8 1.7 1 2 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
            Consultar por WhatsApp
          </a>
          <p style="text-align:center;color:var(--faint);font-family:var(--f-mono);font-size:.76rem;margin-top:12px">Respondemos rápido · {SITE.horarios}</p>
        </aside>
      </div>
    </div>
  </section>

  <script>
    const main = document.getElementById('mainImg');
    document.querySelectorAll('.thumbs img').forEach((t) => {
      t.addEventListener('click', () => {
        main.src = t.dataset.src;
        document.querySelectorAll('.thumbs img').forEach((x) => x.classList.remove('active'));
        t.classList.add('active');
      });
    });
  </script>
</Base>
