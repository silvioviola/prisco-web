---
import Base from '../layouts/Base.astro';
import { SITE, waLink } from '../lib/site';
const mapsQuery = encodeURIComponent(`${SITE.direccion}, Argentina`);
---
<Base title="Contacto" description="Contactá a PRISCO Automotores en San Martín, Mendoza. WhatsApp, email y ubicación.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h1 class="section-title">Hablemos</h1>
      <p class="section-sub">Estamos en {SITE.direccion}. Escribinos por WhatsApp o pasá a vernos.</p>

      <div class="ficha">
        <div>
          <div style="border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--surface-3)">
            <iframe
              title="Ubicación PRISCO Automotores"
              width="100%"
              height="360"
              style="border:0;display:block"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}
            ></iframe>
          </div>
        </div>
        <aside class="ficha-panel" style="position:static">
          <h2 style="font-size:1.2rem;color:#fff;margin-bottom:12px">Datos de contacto</h2>
          <ul class="specs" style="grid-template-columns:1fr">
            <li><div class="k">Dirección</div><div class="v">{SITE.direccion}</div></li>
            <li><div class="k">Horarios</div><div class="v">{SITE.horarios}</div></li>
            <li><div class="k">Email</div><div class="v">{SITE.email}</div></li>
          </ul>
          <a class="btn btn-wa btn-block" href={waLink('Hola, quiero hacer una consulta.')} target="_blank" rel="noopener" style="margin-top:6px">Escribir por WhatsApp</a>
          {SITE.instagram && <a class="btn btn-ghost btn-block" href={SITE.instagram} style="margin-top:10px">Ver Instagram</a>}
        </aside>
      </div>
    </div>
  </section>
</Base>
