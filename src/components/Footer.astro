---
import { SITE, waLink } from '../lib/site';
const year = new Date().getFullYear();
const creditorWa = 'https://wa.me/5492664652840?text=' + encodeURIComponent('Hola Silvio, vi la web de PRISCO Automotores y quiero consultarte por una página.');
const creditorIn = 'https://www.linkedin.com/in/silvioviolaaitrainer';
---
<footer class="site-footer">
  <div class="container">
    <div>
      <div class="fbrand">
        <img src="/brand/logo-light.png" alt="PRISCO" width="40" height="40" />
        <div class="word">PRISCO<small>AUTOMOTORES</small></div>
      </div>
      <p>{SITE.slogan}</p>
      <p>Agencia multimarca de usados y 0km en {SITE.direccion}.</p>
    </div>
    <div>
      <h4>Navegación</h4>
      <a href="/stock">Stock de vehículos</a>
      <a href="/servicios">Financiación y permuta</a>
      <a href="/vende-tu-auto">Vendé o consigná tu auto</a>
      <a href="/contacto">Contacto</a>
    </div>
    <div>
      <h4>Contacto</h4>
      <a href={waLink('Hola, quiero hacer una consulta.')}>WhatsApp</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p>{SITE.direccion}</p>
      <p>{SITE.horarios}</p>
      {SITE.instagram && <a href={SITE.instagram}>Instagram</a>}
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <span>© {year} PRISCO Automotores · Todos los derechos reservados.</span>
      <span class="credit">
        Diseño y desarrollo: <strong>Silvio Viola</strong>
        <a class="credit-ic" href={creditorWa} target="_blank" rel="noopener nofollow" aria-label="WhatsApp de Silvio Viola" title="WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.4.6c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.8.9.8 1.7 1 2 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
        </a>
        <a class="credit-ic" href={creditorIn} target="_blank" rel="noopener nofollow" aria-label="LinkedIn de Silvio Viola" title="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.35c0-1.28-.02-2.92-1.78-2.92-1.78 0-2.05 1.39-2.05 2.83V21H9z"/></svg>
        </a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-bottom .credit{display:inline-flex;align-items:center;gap:9px;flex-wrap:wrap}
  .footer-bottom .credit strong{color:#fff;font-weight:600}
  .footer-bottom .credit-ic{display:inline-flex;align-items:center;color:var(--muted);transition:color .2s,transform .2s}
  .footer-bottom .credit-ic svg{width:16px;height:16px;display:block}
  .footer-bottom .credit-ic:hover{color:var(--accent-2);transform:translateY(-1px)}
</style>
